# Copy this file to .env and fill in your credentials

EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# API key used by Prowlarr/Newznab clients to authenticate to this server
# In production, change this to a secure random string!
NEWZNAB_APIKEY=generate_a_secure_random_key_here

# ── Core behaviour ────────────────────────────────────────────────────────────
# Whether to allow password-protected releases (default: true)
ALLOW_PASSWORDED=true

# Keep password-flagged results from Easynews (flag is often a false positive)
# EASYNEWS_ALLOW_PASSWORD=false

# Discard cam/screener/3D releases (TRaSH Guides style, default: true)
# DISCARD_LOW_QUALITY=true

# Custom regex to additionally exclude releases (case-insensitive)
# EASYNEWS_EXCLUDE_REGEX=

# Optional: override server port (default 8080)
# PORT=8080

# Minimum video duration in seconds to filter out samples (default: 360)
# MIN_DURATION_SECONDS=360

# Comma-separated list of additional fansub groups for anime detection
# ADDITIONAL_FANSUB_GROUPS=somegroup,anothergroup

# ── Search endpoint ───────────────────────────────────────────────────────────
# Easynews API endpoint: "2.0" (proven default) or "3.0" (newer)
# EASYNEWS_SEARCH_API=2.0

# Enable advanced search: server-side spam filter + file-extension whitelist
# EASYNEWS_ADVANCED_SEARCH=false
# EASYNEWS_SPAM_FILTER=true
# EASYNEWS_FILE_EXTENSIONS=m4v,3gp,mov,divx,xvid,wmv,avi,mpg,mpeg,mp4,mkv,avc,flv,webm

# ── Search quality & recall ───────────────────────────────────────────────────
# Per-title query rewrite rules. Two formats:
#   Simple:  "match => replacement ;; another match => replacement"
#   JSON:    [{"match":"norsemen","to":"Vikingane"}]
# EASYNEWS_QUERY_REPLACE=

# Fold Norwegian æ/ø/å to ASCII digraphs (ae/oe/aa) to find ASCII-named releases
# EASYNEWS_TRANSLITERATE_NORWEGIAN=false

# Drop stopwords (and/of/the) from outbound query for better recall (default: true)
# EASYNEWS_STRIP_STOPWORDS=true

# Extra concurrent search terms merged into results (e.g. for language boosting)
# EASYNEWS_EXTRA_TERMS=nordic
# Run EXTRA_TERMS only when the primary search returns 0 results
# EASYNEWS_EXTRA_TERMS_FALLBACK_ONLY=false

# 0-result fallback: try alternate spellings and custom-title aliases
# EASYNEWS_FALLBACK_SEARCH=false
# EASYNEWS_FALLBACK_TRANSLITERATE=true
# EASYNEWS_FALLBACK_ALT_TITLES=true

# Require subtitle language(s) — ISO 639-2 codes, comma-separated
# (e.g. "nor" for Norwegian). Overridable per-request with &subs=
# EASYNEWS_REQUIRE_SUBS=

# Multi-level sort keys (field: relevance|dsize|dtime|dsubject, dir: -|+)
# EASYNEWS_SORT_1=dtime
# EASYNEWS_SORT_1_DIR=-
# EASYNEWS_SORT_2=
# EASYNEWS_SORT_3=

# ── Result handling ───────────────────────────────────────────────────────────
# Skip season-pack queries (S05 with no episode number)
# IGNORE_SEASON_PACKS=false

# Disable title/quality filters entirely (pass everything through)
# EASYNEWS_DISABLE_FILTERS=false

# On hash dedup: keep newest re-post instead of first (relevance) entry
# EASYNEWS_DEDUP_KEEP_NEWEST=false

# ── Metadata attrs in RSS feed ────────────────────────────────────────────────
# Emit subtitle/audio language tracks, codecs, bitrate, group, password flag
# EASYNEWS_META_SUBS=true
# EASYNEWS_META_AUDIO=true
# EASYNEWS_META_CODECS=true
# EASYNEWS_META_BITRATE=true
# EASYNEWS_META_GROUP=true
# EASYNEWS_META_PASSWORD=true

# ── Caching ───────────────────────────────────────────────────────────────────
# Search result cache TTL in seconds (0 = off, default 300)
# CACHE_TTL=300
# CACHE_MAXSIZE=500

# ── Keepalive & latency ───────────────────────────────────────────────────────
# Background keepalive pings to hold warm TLS connection (default: true)
# EASYNEWS_KEEPALIVE=true
# EASYNEWS_KEEPALIVE_INTERVAL_SECONDS=45
# EASYNEWS_KEEPALIVE_IDLE_SECONDS=40

# Latency hedging: if search takes > hedge_after seconds, fire a parallel request
# SEARCH_BUDGET_SECONDS=3.3
# SEARCH_HEDGE_AFTER_SECONDS=1.2
# SEARCH_ATTEMPT_TIMEOUT_SECONDS=2.5
